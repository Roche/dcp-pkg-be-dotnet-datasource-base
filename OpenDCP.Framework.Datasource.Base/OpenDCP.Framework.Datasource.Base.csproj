<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Roche/dcp-pkg-be-dotnet-datasource-base</RepositoryUrl>
    <PackageProjectUrl>https://open-dcp.ai/</PackageProjectUrl>
    <Version>0.5.0</Version>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Factory\**" />
    <EmbeddedResource Remove="Factory\**" />
    <None Remove="Factory\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="OpenDCP.Framework.Configuration.Model" Version="0.3.0" />
    <PackageReference Include="OpenDCP.Framework.Exceptions" Version="0.1.1" />
    <PackageReference Include="OpenDCP.Framework.FormBuilder" Version="0.1.0" />
    <PackageReference Include="OpenDCP.Framework.Security" Version="0.2.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
